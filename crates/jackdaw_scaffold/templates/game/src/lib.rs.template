        transform.rotate_y(cube.speed * config.move_speed * dt);
    }
}

/// Marks the entity the five input actions drive. The template spawns
/// one complete; the full set a hand-authored player needs is listed
/// under "Player controller" above (with physics: five components,
/// two without). Its camera is a rig parented under it — or an
/// `ActiveCameraRig` when another rig already exists.
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default, @EditorCategory::new("Actor"))]
pub struct PlayerMarker;

/// The author's half of the player: the tuning the Components panel
/// edits and the scene saves. Per-entity numbers belong on the entity,
/// game-wide numbers in `GameConfig` — the same split as `SpinningCube`'s
/// `speed` against the config's `move_speed`.
#[derive(Component, Reflect)]
#[reflect(Component, Default, @EditorCategory::new("Actor"))]
pub struct PlayerController {
    /// Ground speed, metres per second.
    pub move_speed: f32,
    /// Launch speed of a jump, metres per second (straight up).
    pub jump_speed: f32,
}

impl Default for PlayerController {
    fn default() -> Self {
        Self {
            move_speed: 4.0,
            jump_speed: 4.5,
        }
    }
}

/// The player: spawned once, on the first entry into the level, and
/// never again. It is code-spawned and part of no scene document, so
/// every switch the flow makes leaves it alone — its entity id is one
/// and the same from Start through game over to Restart (the run's
/// container, not the run). What changes is its numbers, and
/// `reset_run` (right after this on every level entry) is what puts
/// them back.
fn spawn_player(
    mut commands: Commands,
    mut meshes: ResMut<Assets<Mesh>>,
    mut materials: ResMut<Assets<StandardMaterial>>,
    existing: Query<(), With<PlayerMarker>>,
) {
    if !existing.is_empty() {
        return;
    }
    // The visible body. The capsule matches the collider below, so what
    // you see is what collides. `PlayerHealth` is what the hud reads:
    // it starts at the `Default` and `apply_health_from_config` (below)
    // hands the config's `player_health` over as soon as it loads.
    let player = commands
        .spawn((
            PlayerMarker,
            PlayerController::default(),
            PlayerHealth::default(),
            Mesh3d(meshes.add(Capsule3d::new(0.35, 1.0))),
            MeshMaterial3d(materials.add(StandardMaterial {
                base_color: Color::srgb(0.25, 0.55, 0.9),
                ..default()
            })),
            Transform::from_translation(PLAYER_SPAWN),
{{module_physics_player_body}}
        ))
        .id();
    // The follow camera: a rig parented to the player. Parenting is the
    // whole setup — the plugin above activates a lone rig by itself and
    // drives it around its parent every frame.
    commands.spawn((CameraRig::default(), ChildOf(player)));
}

/// The horizontal direction the Move action asks for this frame, in
/// world space but relative to the camera: rotate the stick/WASD input
/// by the camera's yaw so W is always "away from the camera", then
/// clamp to unit length so diagonals are not faster.
fn move_direction(move_input: Vec2, camera_yaw: f32) -> Vec3 {
    let forward = Quat::from_rotation_y(camera_yaw) * -Vec3::Z;
    let right = Quat::from_rotation_y(camera_yaw) * Vec3::X;
    let mut direction = right * move_input.x + forward * move_input.y;
    direction.y = 0.0;
    if direction.length_squared() > 1.0 {
        direction = direction.normalize();
    }
    direction
}

/// How quickly the body turns to face where it walks: the fraction of
/// the turn to take scales with this, so the turn takes roughly a
/// tenth of a second at any frame rate.
const PLAYER_TURN_RATE: f32 = 12.0;

/// Turn `transform` to face `direction` smoothly — the body runs to
/// face where it walks instead of snapping. Skipped when there is no
/// movement this frame.
fn face_movement_direction(direction: Vec3, dt: f32, transform: &mut Transform) {
    let horizontal = Vec3::new(direction.x, 0.0, direction.z);
    if horizontal.length_squared() < 1e-6 {
        return;
    }
    let facing = horizontal.normalize();
    // `-Z` faces the rotation's "forward"; solve for the yaw that puts
    // it along `facing`.
    let target = Quat::from_rotation_y((-facing.x).atan2(-facing.z));
    let turn = (PLAYER_TURN_RATE * dt).clamp(0.0, 1.0);
    transform.rotation = transform.rotation.slerp(target, turn);
}

/// The Look action drives the rig's orientation: mouse (and right
/// stick) motion becomes `CameraLook` yaw and pitch — the same state
/// the rig's own right-mouse-drag channel writes. While that button is
/// held the bridge yields, so the two channels never double-write the
/// same turn.
fn look_into_camera(
    actions: Res<GameActions>,
    mouse: Option<Res<ButtonInput<MouseButton>>>,
    mut rigs: Query<(&CameraRig, &mut CameraLook)>,
) {
    if mouse
        .as_deref()
        .is_some_and(|buttons| buttons.pressed(MouseButton::Right))
    {
        return;
    }
    let look = actions.value("Look");
    if look == Vec2::ZERO {
        return;
    }
    for (rig, mut camera) in &mut rigs {
        camera.yaw -= look.x * rig.sensitivity;
        camera.pitch = match rig.mode {
            // Third person: look down increases the pitch, bounded to
            // stay above the horizon.
            CameraMode::ThirdPerson => {
                (camera.pitch + look.y * rig.sensitivity).clamp(0.05, 1.4)
            }
            // First person: look up increases the pitch, bounded to
            // stay short of straight up/down.
            CameraMode::FirstPerson => {
                (camera.pitch - look.y * rig.sensitivity).clamp(-1.4, 1.4)
            }
        };
    }
}

// ---- Game flow: three worlds, one state machine ----------------------
// The states, the document each one shows, the cameras that render the
// ones without a rig, and the systems that move between them. The
// documents themselves are data — open `menu.bsn`, `scene.bsn` or
// `gameover.bsn` in the editor to restyle or rewire them.

/// The scene documents the flow moves between, spelled once: the boot
/// fallback, the state mapping and the per-state swaps all name the
/// same three files.
const MENU_SCENE: &str = "menu.bsn";
const LEVEL_SCENE: &str = "scene.bsn";
const GAME_OVER_SCENE: &str = "gameover.bsn";
/// The level's overlay (see "Game UI" below) — not a world of its own,
/// so it is not in the flow file's rotation; it lives and dies with
/// `LEVEL_SCENE`.
const HUD_SCENE: &str = "hud.bsn";

/// The scene the game boots into, read once in `GamePlugin::build`:
/// the same string maps to the initial [`GameFlow`] state (through
/// [`boot_state`]) and is loaded by [`spawn_scene`], so the state
/// machine and the first document can never disagree (that mismatch is
/// exactly what a Play-Current launch would otherwise produce).
#[derive(Resource)]
struct BootScene(String);

/// Which world the game is in. The `States` derive makes it bevy's
/// state machine: `OnEnter`/`OnExit` schedules run per state and
/// `DespawnOnExit(GameFlow::Menu)` removes an entity when `Menu` ends.
/// The worlds are mutually exclusive by construction — the flow re-binds
/// one scene root per state — and the hud's bindings deliberately do
/// not read this enum: bindings resolve resource and component paths,
/// so the one bool they do read lives in [`GameState`] next door.
/// States for worlds, bools for binding data.
#[derive(States, Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
pub enum GameFlow {
    /// The start screen: the `menu.bsn` document and its own camera.
    #[default]
    Menu,
    /// The playable world: `scene.bsn`, the player, the hud.
    Level,
    /// The end screen: the `gameover.bsn` document and its own camera.
    GameOver,
}

/// The boot mapping: the menu document boots as the menu, the
/// game-over document as the end screen, and any other start scene —
/// including the editor's own scene on a Play-Current launch — as a
/// world to play.
fn boot_state(start: &str) -> GameFlow {
    match start {
        MENU_SCENE => GameFlow::Menu,
        GAME_OVER_SCENE => GameFlow::GameOver,
        _ => GameFlow::Level,
    }
}

/// Marks the scene root the flow moves the worlds under. Three
/// documents pass through this root one at a time; the root entity and
/// its `Name` are the one stable thing across a switch.
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default)]
pub struct GameRoot;

/// The menu document's own marker, authored on its root in
/// `menu.bsn` — the hook anything that wants to find the menu looks
/// for (the editor's Play view, a BRP query, your own systems). The
/// `Default` here is load-bearing: the document's bare marker line
/// applies through `ReflectDefault`.
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default)]
pub struct MenuRoot;

/// The game-over document's marker, same shape as [`MenuRoot`].
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default)]
pub struct GameOverRoot;

/// Show the menu: re-bind the game root to the menu document, and
/// raise the UI camera that renders it, scoped to this state.
///
/// A switch is one handle insert: the runtime despawns the old
/// document's members and spawns the new one when it loads, so there is
/// nothing here to clean up by hand. And the very first `OnEnter` —
/// the boot state's — runs before `Startup` has spawned the root: there
/// is nothing to re-bind, and the root already boots on the document
/// the state was mapped from (they read the same `BootScene`).
fn enter_menu(
    mut commands: Commands,
    roots: Query<Entity, With<GameRoot>>,
    server: Res<AssetServer>,
) {
    if let Ok(root) = roots.single() {
        commands
            .entity(root)
            .insert(JackdawSceneRoot(server.load(MENU_SCENE)));
    }
    // A UI document shown alone has no camera to render it (the level's
    // camera is the rig under the player), so each UI world brings its
    // own: 2D, marked as the UI camera, ordered above the rig's 3D one,
    // and removed with the state — `DespawnOnExit` is the whole
    // lifecycle.
    commands.spawn((
        Name::new("MenuUiCamera"),
        Camera2d,
        IsDefaultUiCamera,
        Camera {
            order: 1,
            ..default()
        },
        DespawnOnExit(GameFlow::Menu),
    ));
}

/// Show the level: re-bind the game root to the level document. The
/// hud follows in the Update watcher below, the player and its rig
/// spawn once beside the root, and the level's props arrive with their
/// own `DespawnOnExit(GameFlow::Level)` — see the physics section.
fn enter_level(
    mut commands: Commands,
    roots: Query<Entity, With<GameRoot>>,
    server: Res<AssetServer>,
) {
    if let Ok(root) = roots.single() {
        commands
            .entity(root)
            .insert(JackdawSceneRoot(server.load(LEVEL_SCENE)));
    }
}

/// Show the end screen: the game-over document and its camera, the
/// same shape as the menu.
fn enter_game_over(
    mut commands: Commands,
    roots: Query<Entity, With<GameRoot>>,
    server: Res<AssetServer>,
) {
    if let Ok(root) = roots.single() {
        commands
            .entity(root)
            .insert(JackdawSceneRoot(server.load(GAME_OVER_SCENE)));
    }
    commands.spawn((
        Name::new("GameOverUiCamera"),
        Camera2d,
        IsDefaultUiCamera,
        Camera {
            order: 1,
            ..default()
        },
        DespawnOnExit(GameFlow::GameOver),
    ));
}

/// The level's HUD: spawned when the level becomes current, scoped to
/// it (`DespawnOnExit`), back fresh on the next entry. A watcher in
/// `Update` rather than an `OnEnter` spawn on purpose: the hud root
/// must land at a HIGHER entity index than the game root, or the
/// editor's Play would swap the hud document instead of the world —
/// and a boot into `Level` (Play-Current, or a flow file that names a
/// level) enters the state before `Startup` spawns the main root. This
/// way the ordering holds on every entry, not just the first.
fn spawn_hud_while_level(
    mut commands: Commands,
    server: Res<AssetServer>,
    flow: Res<State<GameFlow>>,
    mut live: Local<bool>,
) {
    let live_now = flow.get() == &GameFlow::Level;
    if live_now && !*live {
        commands.spawn((
            JackdawSceneRoot(server.load(HUD_SCENE)),
            DespawnOnExit(GameFlow::Level),
        ));
    }
    *live = live_now;
}

/// Which screen is up inside the level. The hud's bindings read this
/// resource: the pause screen's `Visibility` is bound to the bool, so
/// flipping it is the whole show/hide mechanism. The worlds are
/// `GameFlow`'s to make; overlays inside one world are bools like this.
#[derive(Resource, Reflect, Default)]
#[reflect(Resource, Default)]
pub struct GameState {
    pub paused: bool,
}

/// What a flow or hud button says. The button's `Action` binding in
/// `menu.bsn`, `hud.bsn` or `gameover.bsn` sends this with `button`
/// filled from its literal (`"start"`, `"resume"`, `"restart"`,
/// `"menu"`) — one event for every screen's buttons: the payload, not
/// the type, says what was pressed.
#[derive(Event, Reflect, Clone, Default)]
#[reflect(Event, Default)]
pub struct ScreenPressed {
    pub button: String,
}

/// The health the hud reads, live on the player. The component is the
/// run's state; `GameConfig.player_health` is the author's starting
/// number for it — `apply_health_from_config` below hands one to the
/// other. Same split as the falling cube's `speed` (component, live)
/// against the config's `move_speed` (asset, author intent).
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default, @EditorCategory::new("Actor"))]
pub struct PlayerHealth {
    pub current: f32,
    pub max: f32,
}

/// How much one hit takes off, wherever it comes from (the hazard
/// sensors with the physics module, the Interact key without).
const PLAYER_DAMAGE: f32 = 15.0;

/// Where a run begins — the first entry and every reset both use it,
/// so a restart lands exactly where the game started.
const PLAYER_SPAWN: Vec3 = Vec3::new(-2.0, 1.0, 0.0);

/// current/max -> 0..1 for the health bar's fill. Registered in
/// `GamePlugin` above: a binding's `via` can only call functions the
/// game has registered, and this one turns two component fields into
/// the one number a bar wants.
fn ratio(current: f32, max: f32) -> f32 {
    (current / max).clamp(0.0, 1.0)
}

/// Boolean not, for bindings that show a thing while a flag is false.
/// Registered like `ratio`.
fn not(value: bool) -> bool {
    !value
}

/// Zero means the run is over — registered like `ratio` (the
/// `is_zero`-bound veil in `hud_scenario` is the pattern; this game
/// ends its runs through `GameFlow` instead and keeps the function
/// here as the other half of the pair your own bindings reach for).
fn is_zero(value: f32) -> bool {
    value == 0.0
}

/// The marker the hud document itself carries, so the game can tell
/// the UI root from everything else it spawns. The `Default` here is
/// load-bearing: the document's bare `HudRoot` line applies through
/// `ReflectDefault`.
#[derive(Component, Reflect, Default)]
#[reflect(Component, Default)]
pub struct HudRoot;

/// Point the hud at the player: once the document spawns, its root
/// gets a `BindContext(player)` and every binding inside resolves the
/// player's components (the health below, the pickup counter the
/// physics module adds) against that entity. This insert is the whole
/// wiring — nothing else needs to know the UI exists. `Added` re-fires
/// for every fresh hud the flow spawns, so each entry into the level
/// re-wires itself.
fn wire_hud(
    mut commands: Commands,
    hud_roots: Query<Entity, Added<HudRoot>>,
    players: Query<Entity, With<PlayerMarker>>,
) {
    let (Ok(root), Ok(player)) = (hud_roots.single(), players.single()) else {
        return;
    };
    commands.entity(root).insert(BindContext(player));
}

/// What the flow documents' buttons do. The bindings send
/// `ScreenPressed`; this observer is the whole behavior — Start and
/// Restart both move the flow to the level (Restart's reset is
/// `reset_run`, which runs on every entry into the level — switching
/// IS the reset), Menu goes back to the start screen, Resume drops the
/// pause veil.
fn on_screen_pressed(
    press: On<ScreenPressed>,
    mut flow: ResMut<NextState<GameFlow>>,
    mut state: ResMut<GameState>,
) {
    match press.event().button.as_str() {
        // Start and Restart both move the flow to the level: the run's
        // numbers come back through `reset_run` on the entry, so
        // Restart needs nothing of its own.
        "start" | "restart" => flow.set(GameFlow::Level),
        "menu" => flow.set(GameFlow::Menu),
        "resume" => state.paused = false,
        _ => {}
    }
}

/// The run's numbers come back on every entry into the level — the
/// first one and every Restart both land here, so the end screen's
/// Restart button needs no reset logic of its own. Full health comes
/// straight from the config (the author's number, the same one
/// `apply_health_from_config` hands over on load), and the player goes
/// back to the spawn point. The player itself is not respawned: it
/// crossed the switch untouched (`spawn_player` runs once). Chained
/// right after `spawn_player` on purpose: a freshly spawned player
/// carries a zeroed health, and this is what fills it before any
/// game-over check can read it.
fn reset_run(
    config: Res<GameConfig>,
    mut players: Query<(&mut PlayerHealth, &mut Transform), With<PlayerMarker>>,
) {
    for (mut health, mut transform) in &mut players {
        health.max = config.player_health;
        health.current = config.player_health;
        *transform = Transform::from_translation(PLAYER_SPAWN);
    }
}

/// The Pause action stops being a log line: Escape (or Start) flips
/// `paused` and the pause screen's visibility follows — and it belongs
/// to the level: on the menu or the end screen a screen already owns
/// the moment, so only a current `Level` answers. The Resume button
/// lands on the same bool through `on_screen_pressed` — one piece of
/// state, two doors in.
fn handle_pause_action(
    actions: Res<GameActions>,
    flow: Res<State<GameFlow>>,
    mut state: ResMut<GameState>,
) {
    if actions.just_pressed("Pause") && flow.get() == &GameFlow::Level {
        state.paused = !state.paused;
    }
}

/// The config hands its `player_health` to the component the run
/// actually reads: the config is the author's starting number, the
/// component is live state (damage moves it; the config does not
/// follow back). Runs on config change, so the file's first load and
/// an editor mid-run edit both carry — the same shape as gravity.
fn apply_health_from_config(
    config: Res<GameConfig>,
    mut players: Query<&mut PlayerHealth, With<PlayerMarker>>,
) {
    if !config.is_changed() {
        return;
    }
    for mut health in &mut players {
        health.max = config.player_health;
        health.current = config.player_health;
    }
}

/// Damage lands here (the hazard sensors below, or the Interact key
/// when a game has no physics module). Clamped at zero; the game-over
/// check is what reacts.
fn take_damage(health: &mut PlayerHealth, amount: f32) {
    health.current = (health.current - amount).max(0.0);
}

/// Blood out ends the run: the flow moves to the game-over world, and
/// its `OnEnter` swaps the document and raises the end screen's
/// camera. Only a current `Level` can end — a player on the menu or
/// the end screen is not in a run.
fn update_game_over(
    flow: Res<State<GameFlow>>,
    mut next: ResMut<NextState<GameFlow>>,
    mut state: ResMut<GameState>,
    players: Query<&PlayerHealth, With<PlayerMarker>>,
) {
    if flow.get() != &GameFlow::Level {
        return;
    }
    for health in &players {
        if health.current <= 0.0 {
            state.paused = false;
            next.set(GameFlow::GameOver);
            break;
        }
    }
}
